---
    import * as ImageHelpers from "../helpers/image";
    import * as ImageQueries from "../queries/image";
    import * as SketchQueries from "../queries/sketch";

    import Default from "./default.astro";
    import Background from "../components/client/background.svelte";
    import Page from "../components/client/page.svelte";

    import Config from "../config";

    export interface Props {
        domain: string | undefined, 
        path: string | undefined,
    }

    const {domain, path} = Astro.params;
    const env = Config.env;

    const url = `${domain}${path ? `/${path}` : ""}`;
    const embed = await (async () => {
        if (domain === "image") {
            const name = path;

            const image = name 
                ? await ImageQueries.get_one(name)
                : await ImageQueries.get_latest();

            return {
                url, 
                image_url: image ? ImageHelpers.get_image_url(image.name) : "",
                descr: `${image?.title ?? "unknown"} · ${image?.date ?? new Date()}`,
            };
        } else if (domain === "sketch") {
            const name = path;

            const sketch = name 
                ? await SketchQueries.get_one(name)
                : await SketchQueries.get_latest();

            return {
                url, 
                image_url: sketch?.image_url ?? "", 
                descr: sketch?.name ?? "unknown",
            };
        }
    })();
---

<Default embed_url={embed?.url} embed_image_url={embed?.image_url} embed_descr={embed?.descr}>
	<div class="page-body" data-domain={domain ?? "home"} data-path={path} data-env={env === "prod" ? undefined : env}>
        <Background client:only="svelte" />
        <Page client:only="svelte" />
    </div>
</Default>

<style>
    :global(*) {
        font-family: "lekton";
    }
</style>

<script>
    import * as Domain from "../helpers/domain"
    import * as Nav from "../components/client/nav.svelte.ts"
    import * as Theme from "../components/client/theme.svelte.ts"
    import * as ClientPage from "../components/client/page.svelte.ts"

    const body = document.querySelector(".page-body");

    // @ts-ignore
    const domain = body?.dataset["domain"];
    // @ts-ignore
    const path = body?.dataset["path"];
    // @ts-ignore
    const env = body?.dataset["env"] ?? "prod";

    let page = Domain.path_to_page(`${domain}${path ? `/${path}` : ""}`);
    page = Nav.is_incomplete_page(page)
        ? await Nav.get_landing_page(page.domain)
        : page;

    if (page.domain === "home") {
        page.rune_i = Theme.load_rune_i();
    }

    ClientPage.state.current = page;
    ClientPage.state.env = env;

    window.history.replaceState(page, "");
    Nav.set_domain_items(Nav.state, domain);
</script>
