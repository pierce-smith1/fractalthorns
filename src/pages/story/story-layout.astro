---
    import Default from "../../layouts/default.astro";

    const {
        image,
        title,
        primary_color,
        secondary_color,
        image_dir,
    } = Astro.props.frontmatter;
---

<Default>
    <div class="container" data-image-dir={image_dir}>
        <div class="header-container">
            <img class="header-image" src={image}>
            <div class="title"><strong>{title}</strong></div>
            <div class="toc">
                <ol>
                </ol>
            </div>
        </div>
        <div class="story">
            <slot />
        </div>
    </div>
</Default>

<script>
    const headers = [...document.querySelectorAll("h2")];
    const toc_list = document.querySelector(".toc ol")!;

    for (const header of headers) {
        const item = document.createElement("li");
        const link = document.createElement("a");

        link.href = `#${header.id}`;
        link.innerText = header.innerText;

        item.appendChild(link);
        toc_list.appendChild(item);
    }

    const image_dir = document.querySelector<HTMLElement>(".container")!.dataset.imageDir;

    const act_images = [...document.querySelectorAll<HTMLElement>(".act-img")];
    const act_image_frames = [...document.querySelectorAll<HTMLElement>(".act-img-frame")];

    for (const act_image of act_images) {
        const n = /act-(\w+)/.exec(act_image.id)![1];
        act_image.style.backgroundImage = `url("/assets/images/${image_dir}/act-image-${n}.png")`;
    }

    for (const act_image_frame of act_image_frames) {
        const n = /frame-(\w+)/.exec(act_image_frame.id)![1];
        act_image_frame.style.backgroundImage = `url("/assets/images/${image_dir}/act-image-frame-${n}.png")`;
    }
</script>

<style define:vars={{ primary_color, secondary_color }}>
    * {
        font-family: "eczar";
        font-size: 1.05em;
        color: #334;
    }

    .container {
        display: flex;
        flex-flow: column;
        justify-content: center;
        align-items: center;
        background-color: #eee;
    }

    :global(h2) {
        padding-top: 20px;
    }

    :global(p) {
        padding-left: 20px;
        border-left: 1px solid color-mix(in hsl, var(--primary_color), white );
    }

    :global(blockquote) :global(p) {
        border: none;
        font-style: italic;
        line-height: 1em;
        color: #a3a;
        font-size: 1.2em;
    }

    .header-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        max-width: 1920px;
        min-height: 100%;
        object-fit: cover;
    }

    .title {
        padding: 5vw;
        max-width: 25em;
        filter: drop-shadow(var(--primary_color) 0 0 10px);
    }

    @media screen and (max-width: 800px) {
        .title {
            left: 20px;
            top: 20px;
        }
    }

    .title * {
        font-size: 4em;
        line-height: 1em;
        color: var(--primary_color);
    }

    .header-container {
        position: relative;
        display: flex;
        flex-flow: column nowrap;
        width: 100%;
        max-width: 1920px;
    }

    @media screen and (max-width: 800px) {
        .toc {
            position: relative;
            left: 0;
            top: 0;
        }
    }

    .toc ol {
        list-style-type: none;
        position: sticky;
        background-color: rgba(0 0 0 / 50%);
        width: fit-content;
        padding: 2em 8em 2em 4em;
        margin-bottom: 20vw;
    }

    :global(.toc *) {
        color: var(--secondary_color);
        text-decoration: none;
    }

    :global(.toc a:hover)  {
        color: #fa0;
        transition: color 0.3s ease-in-out;
    }

    .story {
        width: 800px;
        padding: 0 5em;
        background-color: #eee;
        z-index: 1000;
    }

    @media screen and (max-width: 800px) {
        .story {
            width: 90%;
        }
    }

    :global(.act-img-header) {
        position: relative;
        width: 800px;
        height: 225px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    @media screen and (max-width: 800px) {
        :global(.act-img-header) {
            width: 100%;
            border-left: 1px solid #dad;
            border-right: 1px solid #dad;
        }
    }

    :global(.act-img-frame) {
        position: absolute;
        top: 0;
        left: 0;
        background-position: center;
        background-repeat: no-repeat;
        width: 800px;
        height: 225px;
    }

    @media screen and (max-width: 800px) {
        :global(.act-img-frame) {
            width: 100%;
        }
    }

    :global(.act-img) {
        position: relative;
        width: 700px;
        height: 125px;
        background-position: left;
        isolation: isolate;
    }

    @media screen and (max-width: 800px) {
        :global(.act-img) {
            width: 100%;
        }
    }
</style>
