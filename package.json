{
  "name": "rva",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "env-cmd -f rvaenv astro dev",
    "start": "env-cmd -f rvaenv astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ensure-database": "env-cmd -f rvaenv drizzle-kit push",
    "compile-content": "npm run ensure-database && env-cmd -f rvaenv tsx src/data/repopulate.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.3.3",
    "@astrojs/node": "^8.2.3",
    "@astrojs/svelte": "^5.0.3",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.5",
    "@types/p5": "^1.7.6",
    "astro": "^4.16.7",
    "base-64": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "env-cmd": "^10.1.0",
    "fast-png": "^6.2.0",
    "js-base64": "^3.7.7",
    "jszip": "^3.10.1",
    "marked": "^12.0.2",
    "p5": "^1.9.0",
    "sharp": "^0.33.1",
    "svelte": "^4.2.19",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vite-plugin-javascript-obfuscator": "^3.1.0"
  }
}
